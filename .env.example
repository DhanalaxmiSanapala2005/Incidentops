# Backend
DATABASE_URL=postgresql+psycopg2://incident:incident@db:5432/incidentops
SECRET_KEY=change-me-to-a-long-random-string
SANDBOX_SIGNING_KEY=change-me-too
MOCK_SERVICE_KEY=mock-monitoring-key
MOCK_BASE_URL=http://mock:8001
# LLM: none | anthropic | ollama   (none = deterministic template narrative)
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# Frontend
API_URL=http://api:8000

# Tracing (optional). LangGraph/LangChain send traces to LangSmith automatically when these are set.
# Inputs/outputs are hidden by default because incident evidence can contain sensitive text.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incidentops
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# Local Ollama (optional). Without it the app uses rules, templates and keyword search.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1
# OLLAMA_URL=http://localhost:11434          (inside Docker use http://host.docker.internal:11434)
# EMBED_PROVIDER=ollama                       (defaults to ollama when LLM_PROVIDER=ollama, otherwise none)
EMBED_MODEL=nomic-embed-text
EMBED_TIMEOUT_S=30
# RAG_MIN_DENSE=0        # similarity cutoff for refusing out-of-scope questions; 0 = off (not yet measured)
# UPLOAD_DIR=data/uploads  # uploaded runbooks and resolved incidents are stored here
# MOCK_PACK_DIR=data/pack  # folder the mock monitoring service reads telemetry from
